---
const base = import.meta.env.BASE_URL;
const pages = [
  { label: 'Home', href: base },
  { label: 'Projects', href: `${base}projects/` },
  { label: 'Me', href: `${base}me/` },
  { label: 'Contact', href: `${base}contact/` },
  { label: 'Personal Creativity', href: `${base}personal-creativity/` },
];
const current = (href: string) => Astro.url.pathname === href ? 'page' : undefined;
---

<header class="site-header">
  <nav aria-label="Portfolio pages">
    <ul>
      {pages.map(({ label, href }) => (
        <li><a href={href} aria-current={current(href)}>{label}</a></li>
      ))}
    </ul>
  </nav>
</header>
