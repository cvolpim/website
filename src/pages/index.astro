---
import Base from '../layouts/Base.astro';
import flightStudies from '../assets/flight-studies.webp';
---

<Base
  title="Chiara Volpi Manjarrés · Portfolio"
  description="Explore Chiara Volpi Manjarrés’s portfolio, projects, and personal creative work."
>
  <main id="content" class="home" tabindex="-1">
    <h1 class="visually-hidden">Chiara Volpi Manjarrés · Portfolio</h1>
    <p class="visualization" style={`--flight-studies: url('${flightStudies.src}')`}>
      Designing <span class="visualization__insert" aria-hidden="true">&#123;<span class="visualization__photo visualization__photo--scarlet"></span>&#125;</span>
      to empower <span class="visualization__insert" aria-hidden="true">&#123;<span class="visualization__photo visualization__photo--green"></span>&#125;</span>
      patients, providers, caregivers, and the general public <span class="visualization__insert" aria-hidden="true">&#123;<span class="visualization__photo visualization__photo--gold"></span>&#125;</span>
      through language <span class="visualization__insert" aria-hidden="true">&#123;<span class="visualization__photo visualization__photo--coral"></span>&#125;</span>
      in healthcare and learning ecosystems.
    </p>
  </main>
</Base>
