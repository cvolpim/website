---
import { Image } from 'astro:assets';
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import Base from '../../layouts/Base.astro';
import { projects } from '../../data/projects';

export const getStaticPaths = (() => projects.map((project) => ({
  params: { slug: project.slug },
  props: { project },
}))) satisfies GetStaticPaths;

const { project } = Astro.props as InferGetStaticPropsType<typeof getStaticPaths>;
const projectsPath = `${import.meta.env.BASE_URL}projects/`;
---

<Base title={`${project.title} · Chiara Volpi Manjarrés`} description={project.description}>
  <main id="content" class="content-page project-detail" tabindex="-1">
    <a class="project-detail__back" href={projectsPath}>All projects</a>
    <p class="project-label">{project.label}</p>
    <h1>{project.title}</h1>
    <p>{project.description}</p>
    <Image class="project-detail__cover" src={project.cover} alt={project.coverAlt} />
  </main>
</Base>
